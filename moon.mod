name = "Lxxbv/moon_typst"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/Lxxbv/moon-typst"

license = "Apache-2.0"

keywords = [
  "typst",
  "typesetting",
  "parser",
  "layout",
  "svg",
  "html",
  "renderer"
]

description = "A lightweight Typst markup parser, layout engine, and SVG/HTML renderer written in pure MoonBit."

preferred_target = "wasm-gc"

import {
  "moonbitlang/x@0.5.5",
}
